# Aerys VPS — configuration Milan (agent DevOps @milan, projet eval-autonomie)
# Copier vers .env et remplir les valeurs. Formats incorrects provoquent l'erreur E005 :
#   dictionary update sequence element #0 has length 1; 2 is required

# JSON objet (alias → URL GitHub). PAS une URL brute ni un tableau JSON.
CURSOR_REPO_MAP={"eval-autonomie":"https://github.com/Lucid-Project-Official/aerys-eval-sandbox"}

# Jeton brut Cursor Dashboard. PAS de format KEY=VALUE.
CURSOR_API_KEY=

# Clé de chiffrement du coffre connecteurs Aerys (Dashboard → Connecteurs).
CONNECTOR_ENCRYPTION_KEY=

# Optionnel — paires KEY=VALUE séparées par ; (chaque segment doit contenir '=').
# AERYS_CONNECTOR_CONFIG=GITHUB_OWNER=Lucid-Project-Official;GITHUB_REPO=aerys-eval-sandbox
